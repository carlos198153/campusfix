# ÚNICAMENTE estas dos variables son públicas y se incluyen en el navegador.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA_ANON_O_PUBLISHABLE

# Secrets del backend: configurar con `supabase secrets set`, nunca con prefijo VITE_.
# Supabase proporciona SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY.
# APP_ORIGIN=http://localhost:5173,https://tu-dominio.vercel.app
# ADMIN_SETUP_PIN=1324    (solo Edge; sin este secreto el alta de administradores está deshabilitada)
# El NIP solicitado es compartido: quien lo conoce puede registrar administradores.
# OPENAI_API_KEY=...       (opcional; sin clave se usa clasificador por reglas)
# OPENAI_MODEL=gpt-4.1-mini
